# Copy this file to .env and set provider credentials. Never commit .env.
RESERVA_FRONTEND_URL=http://localhost:5173
RESERVA_OAUTH_CALLBACK_URL=http://localhost:5173/api/index.php?action=auth.oauth.callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a unique random key for encrypting saved e-wallet mobile numbers.
PAYMENT_DATA_KEY=

# PayMongo Hosted Checkout. Keep these credentials server-side in .env only.
# Use a test key while developing, then live credentials after PayMongo approval.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Register this event in PayMongo Developers > Webhooks:
# checkout_session.payment.paid
# Endpoint: https://YOUR_PUBLIC_DOMAIN/api/index.php?action=payments.card.webhook
